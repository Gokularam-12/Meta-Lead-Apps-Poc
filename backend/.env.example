# Backend Server Port
PORT=5000

# Meta Webhook Verification Token (set this same secret in Meta App Webhook settings)
META_VERIFY_TOKEN=my_secure_verify_token_123

# Optional: Meta Page Access Token for retrieving live lead field details from Graph API
# If left empty, the server automatically generates realistic placeholder lead data for tests
META_PAGE_ACCESS_TOKEN=

# Meta Graph API Version
META_GRAPH_API_VERSION=v19.0
